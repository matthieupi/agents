# Public configuration only. configure.mjs loads read-only service secret files.
NODE_ENV=production
HOME=/paperclip
PAPERCLIP_HOME=/paperclip
PAPERCLIP_INSTANCE_ID=default
PAPERCLIP_CONFIG=/run/paperclip/config.json
HOST=0.0.0.0
PORT={{ service_config.container_port }}
SERVE_UI=true
USER_UID={{ agent_uid }}
USER_GID={{ agent_gid }}
PAPERCLIP_DEPLOYMENT_MODE={{ service_config.deployment_mode }}
PAPERCLIP_DEPLOYMENT_EXPOSURE={{ service_config.deployment_exposure }}
PAPERCLIP_PUBLIC_URL={{ service_config.public_url }}
PAPERCLIP_AUTH_BASE_URL_MODE=explicit
PAPERCLIP_ALLOWED_HOSTNAMES={{ service_config.hostnames | join(',') }}
PAPERCLIP_TELEMETRY_DISABLED={{ '1' if service_config.telemetry_disabled else '0' }}
PAPERCLIP_ANNOUNCEMENTS_ENABLED=false
HEARTBEAT_SCHEDULER_ENABLED={{ service_config.heartbeat_scheduler_enabled | ternary('true', 'false') }}
PAPERCLIP_AUTH_DISABLE_SIGN_UP={{ service_config.auth_disable_sign_up | ternary('true', 'false') }}
PAPERCLIP_DB_BACKUP_ENABLED=false
PAPERCLIP_DB_USER={{ service_config.database_user }}
PAPERCLIP_DB_NAME={{ service_config.database_name }}
