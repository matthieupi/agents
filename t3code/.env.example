# Documentation only; wrappers do not source this file or Compose .env.
# No exports needed for: ./t3code build; ./t3code .
# Optional overrides (uncomment/export only the ones intentionally changed):
# T3CODE_IMAGE=sha256:<existing-local-image-id>
# T3CODE_WORKSPACE=/canonical/narrow/project
# T3CODE_STATE_ROOT=/canonical/operator-owned-private-registry
# T3CODE_AGENT_ROOT=/canonical/shared/agent
# T3CODE_BUILD_PLATFORM=linux/amd64
T3CODE_PROVIDER=none
T3CODE_PORT=3773
T3CODE_CPUS=2
T3CODE_MEMORY=4g
# State defaults to account-home ~/.local/state/t3code, safely created mode 0700.
# Shared root defaults to component-adjacent ../agent; workspace defaults to cwd.
# UID/GID are derived from the non-root operator, not configurable.
# Build artifact selection belongs in runtime/pins.json, not environment flags.
