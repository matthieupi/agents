# Documentation only. Wrappers do not source this file or load Compose .env.
# Export these explicitly in your operator shell. No credentials belong here.
T3CODE_IMAGE=REQUIRED_LOCAL_SHA256_IMAGE_ID_OR_REPOSITORY_DIGEST
T3CODE_WORKSPACE=REQUIRED_CANONICAL_WORKSPACE_DIRECTORY
T3CODE_STATE_ROOT=REQUIRED_PRIVATE_HOST_REGISTRY_DIRECTORY
T3CODE_AGENT_ROOT=REQUIRED_CANONICAL_SHARED_AGENT_DIRECTORY
T3CODE_PROVIDER=none
T3CODE_PORT=3773
T3CODE_CPUS=2
T3CODE_MEMORY=4g
# UID/GID are derived from the invoking non-root operator, not configurable.
# Build-only inputs; all remain unapproved. See README before supplying these.
T3CODE_BUILD_PLATFORM=REQUIRED_REVIEWED_LINUX_AMD64_OR_ARM64
NODE_IMAGE=REQUIRED_EXACT_PATCH_TAG_AND_SHA256_DIGEST
BUILDER_IMAGE=REQUIRED_EXACT_TAG_AND_SHA256_DIGEST
NODE_VERSION=REQUIRED_APPROVED_EXACT_PATCH
T3_VERSION=REQUIRED_APPROVED_EXACT_RELEASE
T3_INTEGRITY=REQUIRED_REVIEWED_SHA512_SRI
PACKAGE_LOCK_SHA256=REQUIRED_REVIEWED_LOCK_SHA256
PREPARED_BASES_REVIEWED=no
INSTALL_HOOKS_REVIEWED=no
