Port {{ service_config.container_port }}
ListenAddress 0.0.0.0
HostKey /run/paperclip-ssh/ssh_host_ed25519_key
AuthorizedKeysFile /etc/paperclip-authorized_keys
AllowUsers {{ agent_account }}
PermitRootLogin no
PubkeyAuthentication yes
PasswordAuthentication no
KbdInteractiveAuthentication no
PermitEmptyPasswords no
AuthenticationMethods publickey
UsePAM no
StrictModes yes
DisableForwarding yes
PermitUserEnvironment no
PermitUserRC no
X11Forwarding no
PermitTunnel no
LogLevel ERROR
PidFile /run/sshd.pid
SetEnv PATH={{ service_config.tool_path }} PI_TELEMETRY=0 OPENCODE_DISABLE_AUTOUPDATE=1
{% if 'paperclip-daemon' in (docker_access | default([])) %}
SetEnv DOCKER_HOST=unix://{{ agent_docker_socket }}
{% endif %}
Subsystem sftp internal-sftp
