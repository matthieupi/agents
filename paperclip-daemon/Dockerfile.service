FROM docker:28.4.0-cli AS docker-cli
FROM node:24.20.0-bookworm-slim@sha256:ba849c60be29959425b8734d57b8b4b7d56f98edd9504c9af091d5281095a71e
ARG OPENCODE_VERSION
ARG PI_VERSION
ARG AGENT_UID
ARG AGENT_GID
ARG AGENT_DOCKER_GID=""
RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates python3 make g++ git openssh-client openssh-server sudo bash \
      coreutils util-linux tini ripgrep \
    && rm -rf /var/lib/apt/lists/* /etc/ssh/ssh_host_* \
    && ln -s /usr/local/bin/node /usr/bin/node \
    && ln -s /usr/local/bin/npm /usr/bin/npm \
    && install -d -o node -g node /opt/opencode/build-home /opt/opencode/component /opt/pi/runtime \
    && install -d -m 0755 /run/sshd
COPY --from=docker-cli /usr/local/bin/docker /usr/local/bin/docker
# Reuse the maintained installer and public plugin inputs at exactly the paths
# used by standalone OpenCode; shared HOME's existing links remain valid.
COPY --from=opencode_inputs scripts/entrypoint.sh /opt/opencode/native-contract.sh
COPY --from=opencode_inputs scripts/publish-plugins.mjs /opt/opencode/component/scripts/publish-plugins.mjs
COPY --from=opencode_inputs --chown=node:node .opencode/config/kdco /opt/opencode/component/.opencode/config/kdco/
COPY --from=opencode_inputs .opencode/config/plugins /opt/opencode/component/.opencode/config/plugins/
USER node
RUN /bin/bash -c 'set -euo pipefail; source /opt/opencode/native-contract.sh; export OPENCODE_USER=node OPENCODE_UID="$(id -u)" OPENCODE_HOME=/opt/opencode/build-home OPENCODE_ROOT=/opt/opencode/component OPENCODE_PREFIX=/opt/opencode/component/.runtime OPENCODE_VERSION; install_runtime' \
    && npm install --prefix /opt/pi/runtime --no-audit --no-fund --include=optional "@earendil-works/pi-coding-agent@$PI_VERSION" \
    && test "$(/opt/pi/runtime/node_modules/.bin/pi --version)" = "$PI_VERSION"
USER root
RUN test "$AGENT_UID" -gt 0 && test "$AGENT_GID" -gt 0 \
    && groupmod -n agent -g "$AGENT_GID" node \
    && usermod -l agent -u "$AGENT_UID" -g "$AGENT_GID" -d /home/agent -s /bin/bash node \
    && passwd -d agent \
    && install -d -m 0700 -o agent -g agent /home/agent \
    && chmod -R a+rX,a-w /opt/opencode/component /opt/pi/runtime \
    && printf 'agent ALL=(ALL:ALL) NOPASSWD: ALL\n' > /etc/sudoers.d/agent \
    && chmod 0440 /etc/sudoers.d/agent \
    && visudo -cf /etc/sudoers.d/agent \
    && if [ -n "$AGENT_DOCKER_GID" ]; then \
         test "$AGENT_DOCKER_GID" -gt 0; \
         getent group "$AGENT_DOCKER_GID" || groupadd -g "$AGENT_DOCKER_GID" docker-access; \
         usermod -aG "$(getent group "$AGENT_DOCKER_GID" | cut -d: -f1)" agent; \
       fi
# sshd is the only persistent service; SSH sessions execute as agent. No runtime
# chown, package installation, provider credential copy, or execution dispatcher.
ENV PATH=/opt/opencode/component/.runtime/bin:/opt/pi/runtime/node_modules/.bin:/usr/local/bin:/usr/bin:/bin
ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["/usr/sbin/sshd", "-D", "-e", "-f", "/etc/paperclip-sshd.conf"]
