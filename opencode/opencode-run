#!/bin/bash
# OpenCode Wrapper - Manages per-directory containerized instances
set -euo pipefail

# Follow symlinks to find the real script directory
SOURCE="${BASH_SOURCE[0]}"
while [[ -L "$SOURCE" ]]; do
    DIR="$(cd "$(dirname "$SOURCE")" && pwd)"
    SOURCE="$(readlink "$SOURCE")"
    [[ "$SOURCE" != /* ]] && SOURCE="$DIR/$SOURCE"
done
SCRIPT_DIR="$(cd "$(dirname "$SOURCE")" && pwd)"

COMPOSE_FILE="${SCRIPT_DIR}/docker-compose.yml"
CPU_IMAGE_NAME="lab/opencode:latest"
GPU_IMAGE_NAME="lab/opencode:gpu"
IMAGE_NAME="${CPU_IMAGE_NAME}"

# Color output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

log_info() { echo -e "${GREEN}[opencode]${NC} $*"; }
log_warn() { echo -e "${YELLOW}[opencode]${NC} $*"; }
log_error() { echo -e "${RED}[opencode]${NC} $*" >&2; }

# Parse optional flags
DANGEROUS_MODE=""
REBUILD_IMAGE=""
WEB_MODE=""
WEB_BIND_HOST="127.0.0.1"
WEB_PORT="4096"
GPU_MODE=""
GPU_DEVICES="all"
GPU_LABEL_DEVICES=""
CPU_LIMIT="8.0"
MEMORY_LIMIT="16g"
PUBLISH_SPECS=()
POSITIONAL_ARGS=()

is_port() {
    [[ "${1:-}" =~ ^[0-9]+$ ]] && (( $1 >= 1 && $1 <= 65535 ))
}

is_gpu_selector() {
    [[ "${1:-}" == "all" || "${1:-}" =~ ^[0-9]+(,[0-9]+)*$ || "${1:-}" =~ ^device=[0-9]+(,[0-9]+)*$ ]]
}

normalize_gpu_devices() {
    local devices="${1:-all}"
    devices="${devices#device=}"
    printf '%s' "${devices}"
}

is_cpu_limit() {
    [[ "${1:-}" =~ ^[0-9]+([.][0-9]+)?$ ]] && awk "BEGIN { exit !($1 > 0) }"
}

is_memory_limit() {
    [[ "${1:-}" =~ ^[0-9]+([.][0-9]+)?[kKmMgG]?$ ]]
}

is_publish_spec() {
    [[ "${1:-}" =~ ^[0-9]+$ || "${1:-}" =~ ^[0-9]+:[0-9]+$ || "${1:-}" =~ ^(127\.0\.0\.1|0\.0\.0\.0):[0-9]+:[0-9]+$ ]]
}

publish_label() {
    local IFS=','
    printf '%s' "${PUBLISH_SPECS[*]}"
}

while [[ $# -gt 0 ]]; do
    case $1 in
        -d|--dangerous)
            DANGEROUS_MODE="--permission allow"
            log_warn "Running in DANGEROUS MODE - all permissions auto-approved!"
            shift
            ;;
        -r|--rebuild)
            REBUILD_IMAGE="1"
            shift
            ;;
        -w|--web)
            WEB_MODE="1"
            WEB_BIND_HOST="127.0.0.1"
            shift
            if [[ $# -gt 0 ]] && is_port "$1"; then
                WEB_PORT="$1"
                shift
            fi
            ;;
        --wlan)
            WEB_MODE="1"
            WEB_BIND_HOST="0.0.0.0"
            shift
            if [[ $# -gt 0 ]] && is_port "$1"; then
                WEB_PORT="$1"
                shift
            fi
            ;;
        --port)
            if ! is_port "${2:-}"; then
                log_error "--port requires a numeric port between 1 and 65535"
                exit 1
            fi
            WEB_PORT="$2"
            shift 2
            ;;
        --gpu|-gpu)
            GPU_MODE="1"
            shift
            if [[ $# -gt 0 ]] && is_gpu_selector "$1"; then
                GPU_DEVICES="$(normalize_gpu_devices "$1")"
                shift
            fi
            ;;
        --cpus)
            if ! is_cpu_limit "${2:-}"; then
                log_error "--cpus requires a positive number, for example: 2, 4, or 8.0"
                exit 1
            fi
            CPU_LIMIT="$2"
            shift 2
            ;;
        --memory|--mem)
            if ! is_memory_limit "${2:-}"; then
                log_error "--memory requires a Docker memory value, for example: 4g, 8192m, or 16g"
                exit 1
            fi
            MEMORY_LIMIT="$2"
            shift 2
            ;;
        --publish|-p)
            if ! is_publish_spec "${2:-}"; then
                log_error "--publish requires PORT, HOST_PORT:CONTAINER_PORT, or HOST_IP:HOST_PORT:CONTAINER_PORT"
                log_error "Examples: --publish 3000 --publish 5173:5173 --publish 127.0.0.1:8080:80"
                exit 1
            fi
            PUBLISH_SPECS+=("$2")
            shift 2
            ;;
        *)
            POSITIONAL_ARGS+=("$1")
            shift
            ;;
    esac
done

if [[ -n "${GPU_MODE}" ]]; then
    IMAGE_NAME="${GPU_IMAGE_NAME}"
fi

# Handle rebuild if requested
if [[ -n "${REBUILD_IMAGE}" ]]; then
    log_info "Rebuilding OpenCode CPU image..."
    docker build -t "${CPU_IMAGE_NAME}" "${SCRIPT_DIR}"
    log_info "CPU image rebuilt successfully"

    log_info "Rebuilding OpenCode GPU image..."
    docker build -f "${SCRIPT_DIR}/Dockerfile.gpu" -t "${GPU_IMAGE_NAME}" "${SCRIPT_DIR}"
    log_info "GPU image rebuilt successfully"

    log_info "OpenCode images rebuilt successfully"
    exit 0
fi

# Restore positional parameters
set -- "${POSITIONAL_ARGS[@]+"${POSITIONAL_ARGS[@]}"}"

# Parse workspace path
WORKSPACE_PATH="${1:-.}"
WORKSPACE_PATH="$(realpath "${WORKSPACE_PATH}")"

# Validate workspace exists
if [[ ! -d "${WORKSPACE_PATH}" ]]; then
    log_error "Directory does not exist: ${WORKSPACE_PATH}"
    exit 1
fi

# Generate unique container name based on workspace path and runtime profile.
# CPU and GPU containers must not share a name: Docker runtime/image settings are
# fixed at container creation time, and recreating one profile should not kill
# active sessions attached to the other profile for the same workspace.
CONTAINER_NAME="opencode-$(basename "${WORKSPACE_PATH}")"
if [[ -n "${GPU_MODE}" ]]; then
    CONTAINER_NAME="${CONTAINER_NAME}-gpu"
fi

has_requested_web_port() {
    local published
    published="$(docker port "${CONTAINER_NAME}" "${WEB_PORT}/tcp" 2>/dev/null || true)"

    if [[ -z "${published}" ]]; then
        return 1
    fi

    if [[ "${WEB_BIND_HOST}" == "127.0.0.1" ]]; then
        grep -q "^127\.0\.0\.1:${WEB_PORT}$" <<< "${published}"
    else
        grep -Eq "^(0\.0\.0\.0|:::):${WEB_PORT}$" <<< "${published}"
    fi
}

has_requested_gpu_config() {
    local configured_devices
    configured_devices="$(docker inspect --format '{{ index .Config.Labels "dev.xmist.opencode.gpu.devices" }}' "${CONTAINER_NAME}" 2>/dev/null || true)"
    [[ "${configured_devices}" == "${GPU_DEVICES}" ]]
}

has_requested_resource_config() {
    local configured_cpus configured_memory
    configured_cpus="$(docker inspect --format '{{ index .Config.Labels "dev.xmist.opencode.cpus" }}' "${CONTAINER_NAME}" 2>/dev/null || true)"
    configured_memory="$(docker inspect --format '{{ index .Config.Labels "dev.xmist.opencode.memory" }}' "${CONTAINER_NAME}" 2>/dev/null || true)"
    [[ "${configured_cpus}" == "${CPU_LIMIT}" && "${configured_memory}" == "${MEMORY_LIMIT}" ]]
}

has_requested_publish_config() {
    local configured_publish
    configured_publish="$(docker inspect --format '{{ index .Config.Labels "dev.xmist.opencode.publish" }}' "${CONTAINER_NAME}" 2>/dev/null || true)"
    [[ "${configured_publish}" == "$(publish_label)" ]]
}

# Check if container exists and is running
CONTAINER_STATUS=$(docker ps -a --filter "name=^${CONTAINER_NAME}$" --format "{{.Status}}" 2>/dev/null || echo "")

if [[ -n "${CONTAINER_STATUS}" ]]; then
    # Container exists - check if it's healthy and running
    RUNNING=$(docker ps -q --filter "name=^${CONTAINER_NAME}$" --filter "status=running" 2>/dev/null || echo "")
    if [[ -n "${RUNNING}" ]]; then
        # Verify it's using the current image
        CONTAINER_IMAGE=$(docker inspect --format '{{.Config.Image}}' "${CONTAINER_NAME}" 2>/dev/null || echo "")
        if [[ "${CONTAINER_IMAGE}" == "${IMAGE_NAME}" ]]; then
            if [[ -n "${WEB_MODE}" ]] && ! has_requested_web_port; then
                log_warn "Container lacks requested web port mapping (${WEB_BIND_HOST}:${WEB_PORT}), recreating..."
                docker rm -f "${CONTAINER_NAME}" > /dev/null 2>&1
            elif [[ -n "${GPU_MODE}" ]] && ! has_requested_gpu_config; then
                log_warn "Container lacks requested GPU configuration (${GPU_DEVICES}), recreating..."
                docker rm -f "${CONTAINER_NAME}" > /dev/null 2>&1
            elif ! has_requested_resource_config; then
                log_warn "Container lacks requested resource configuration (cpus=${CPU_LIMIT}, memory=${MEMORY_LIMIT}), recreating..."
                docker rm -f "${CONTAINER_NAME}" > /dev/null 2>&1
            elif ! has_requested_publish_config; then
                log_warn "Container lacks requested published ports ($(publish_label)), recreating..."
                docker rm -f "${CONTAINER_NAME}" > /dev/null 2>&1
            else
                if [[ -n "${WEB_MODE}" ]]; then
                    if [[ "${WEB_BIND_HOST}" == "0.0.0.0" && -z "${OPENCODE_SERVER_PASSWORD:-}" ]]; then
                        log_warn "LAN web mode is exposed without OPENCODE_SERVER_PASSWORD"
                    fi
                    log_info "Starting browser session: ${CONTAINER_NAME}"
                    log_info "Workspace: ${WORKSPACE_PATH}"
                    log_info "Port: ${WEB_BIND_HOST}:${WEB_PORT}"
                    exec docker exec -it \
                        -e "OPENCODE_SERVER_PASSWORD=${OPENCODE_SERVER_PASSWORD:-}" \
                        -e "OPENCODE_SERVER_USERNAME=${OPENCODE_SERVER_USERNAME:-opencode}" \
                        "${CONTAINER_NAME}" opencode web --hostname 0.0.0.0 --port "${WEB_PORT}"
                fi
            log_info "Attaching to existing session: ${CONTAINER_NAME}"
            log_info "Workspace: ${WORKSPACE_PATH}"
            exec docker exec -it "${CONTAINER_NAME}" opencode ${DANGEROUS_MODE}
            fi
        else
            log_warn "Container uses old image (${CONTAINER_IMAGE}), recreating..."
            docker rm -f "${CONTAINER_NAME}" > /dev/null 2>&1
        fi
    else
        # Container exists but is stopped/restarting/dead - remove and recreate
        log_warn "Removing stale container: ${CONTAINER_NAME} (${CONTAINER_STATUS})"
        docker rm -f "${CONTAINER_NAME}" > /dev/null 2>&1
    fi
fi

# Container doesn't exist - create new one
log_info "Creating new OpenCode instance"
log_info "Workspace: ${WORKSPACE_PATH}"
log_info "Container: ${CONTAINER_NAME}"

# Check if image exists
if ! docker image inspect "${IMAGE_NAME}" > /dev/null 2>&1; then
    log_error "Image ${IMAGE_NAME} not found. Build it first:"
    if [[ -n "${GPU_MODE}" ]]; then
        log_error "  opencode rebuild gpu"
        log_error "  or: opencode -r --gpu ."
    else
        log_error "  cd ${SCRIPT_DIR} && docker compose build"
        log_error "  or: opencode -r ."
    fi
    exit 1
fi

# Prepare config directory
CONFIG_DIR="${SCRIPT_DIR}/.opencode/config"
mkdir -p "${CONFIG_DIR}"

# Prepare data directory for session/auth persistence
DATA_DIR="${SCRIPT_DIR}/.opencode/data"
mkdir -p "${DATA_DIR}"

# Prepare cache directory for provider/plugin state persistence
CACHE_DIR="${SCRIPT_DIR}/.opencode/cache"
mkdir -p "${CACHE_DIR}"
AGENT_DIR="${SCRIPT_DIR}/../agent"
INIT_SCRIPT="${SCRIPT_DIR}/init.sh"

# SSH directory for remote access
SSH_DIR="${SSH_DIR_PATH:-${SCRIPT_DIR}/ssh}"

log_info "Running OpenCode with UID $(id -u):$(id -g)"

PORT_ARGS=()
if [[ -n "${WEB_MODE}" ]]; then
    PORT_ARGS=(-p "${WEB_BIND_HOST}:${WEB_PORT}:${WEB_PORT}")
    if [[ "${WEB_BIND_HOST}" == "0.0.0.0" && -z "${OPENCODE_SERVER_PASSWORD:-}" ]]; then
        log_warn "LAN web mode is exposed without OPENCODE_SERVER_PASSWORD"
    fi
fi

for publish_spec in "${PUBLISH_SPECS[@]}"; do
    PORT_ARGS+=(-p "${publish_spec}")
done

GPU_ARGS=()
if [[ -n "${GPU_MODE}" ]]; then
    GPU_LABEL_DEVICES="${GPU_DEVICES}"
    GPU_ARGS=(--gpus "device=${GPU_DEVICES}")
    if [[ "${GPU_DEVICES}" == "all" ]]; then
        GPU_ARGS=(--gpus all)
    fi
    log_info "GPU access enabled: ${GPU_DEVICES}"
fi

# Create container with workspace-specific settings
docker run -d \
    --name "${CONTAINER_NAME}" \
    --hostname "${CONTAINER_NAME}" \
    --label "dev.xmist.opencode.gpu.devices=${GPU_LABEL_DEVICES}" \
    --label "dev.xmist.opencode.cpus=${CPU_LIMIT}" \
    --label "dev.xmist.opencode.memory=${MEMORY_LIMIT}" \
    --label "dev.xmist.opencode.publish=$(publish_label)" \
    --restart unless-stopped \
    --user "1000:1000" \
    -e "HOME=/home/opencode" \
    -e "PATH=/home/opencode/.local/bin:/usr/local/bin:/usr/bin:/bin" \
    -e "OPENCODE_CONFIG_DIR=/home/opencode/.config/opencode" \
    -e "ANTHROPIC_API_KEY=${ANTHROPIC_API_KEY:-}" \
    -e "OPENAI_API_KEY=${OPENAI_API_KEY:-}" \
    -e "GEMINI_API_KEY=${GEMINI_API_KEY:-}" \
    -e "OPENROUTER_API_KEY=${OPENROUTER_API_KEY:-}" \
    -e "OLLAMA_HOST=${OLLAMA_HOST:-http://ollama.xmist.dev:11434}" \
    -e "OPENAI_COMPAT_API_KEY=${OPENAI_COMPAT_API_KEY:-}" \
    -e "OPENAI_COMPAT_BASE_URL=${OPENAI_COMPAT_BASE_URL:-}" \
    -e "OPENCODE_SERVER_PASSWORD=${OPENCODE_SERVER_PASSWORD:-}" \
    -e "OPENCODE_SERVER_USERNAME=${OPENCODE_SERVER_USERNAME:-opencode}" \
    -e "NVIDIA_VISIBLE_DEVICES=${GPU_DEVICES}" \
    -e "NVIDIA_DRIVER_CAPABILITIES=compute,utility" \
    -e "OPENCODE_CONFIG=/home/opencode/.config/opencode/opencode.json" \
    -e "OPENCODE_DISABLE_AUTOUPDATE=1" \
    -e "TERM=xterm-256color" \
    -e "GIT_AUTHOR_NAME=${GIT_AUTHOR_NAME:-opencode-xmist}" \
    -e "GIT_AUTHOR_EMAIL=${GIT_AUTHOR_EMAIL:-opencode@xmist.dev}" \
    -e "GIT_COMMITTER_NAME=${GIT_AUTHOR_NAME:-opencode-xmist}" \
    -e "GIT_COMMITTER_EMAIL=${GIT_AUTHOR_EMAIL:-opencode@xmist.dev}" \
    -v "${WORKSPACE_PATH}:/workspace:rw" \
    -v "${AGENT_DIR}:/opt/agent:rw" \
    -v "${INIT_SCRIPT}:/opt/harness/init.sh:ro" \
    -v "${CONFIG_DIR}:/home/opencode/.config/opencode:rw" \
    -v "${DATA_DIR}:/home/opencode/.local/share/opencode:rw" \
    -v "${CACHE_DIR}:/home/opencode/.cache/opencode:rw" \
    -v "${SSH_DIR}:/home/opencode/.ssh:ro" \
    "${PORT_ARGS[@]}" \
    "${GPU_ARGS[@]}" \
    --network devai-xmist \
    --memory "${MEMORY_LIMIT}" \
    --cpus "${CPU_LIMIT}" \
    "${IMAGE_NAME}" \
    bash -lc '/opt/harness/init.sh && tail -f /dev/null' > /dev/null

log_info "Container created successfully"

# Wait for container to be fully running
sleep 2

# Verify container is running before attaching
if ! docker ps -q --filter "name=^${CONTAINER_NAME}$" --filter "status=running" | grep -q .; then
    log_error "Container failed to start. Check logs:"
    log_error "  docker logs ${CONTAINER_NAME}"
    exit 1
fi

if [[ -n "${WEB_MODE}" ]]; then
    log_info "Starting browser session..."
    log_info "Port: ${WEB_BIND_HOST}:${WEB_PORT}"
    exec docker exec -it \
        -e "OPENCODE_SERVER_PASSWORD=${OPENCODE_SERVER_PASSWORD:-}" \
        -e "OPENCODE_SERVER_USERNAME=${OPENCODE_SERVER_USERNAME:-opencode}" \
        "${CONTAINER_NAME}" opencode web --hostname 0.0.0.0 --port "${WEB_PORT}"
fi

# Attach to the new container
log_info "Attaching to TUI..."
exec docker exec -it "${CONTAINER_NAME}" opencode ${DANGEROUS_MODE}
