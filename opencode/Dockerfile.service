FROM docker:28.4.0-cli AS docker-cli
FROM node:24.20.0-bookworm-slim@sha256:ba849c60be29959425b8734d57b8b4b7d56f98edd9504c9af091d5281095a71e
ARG OPENCODE_VERSION
ARG AGENT_UID
ARG AGENT_GID
RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates python3 make g++ git openssh-client bash coreutils util-linux tini ripgrep \
    && rm -rf /var/lib/apt/lists/* \
    && ln -s /usr/local/bin/node /usr/bin/node \
    && ln -s /usr/local/bin/npm /usr/bin/npm \
    && install -d -o node -g node /opt/opencode/build-home /opt/opencode/component
COPY --from=docker-cli /usr/local/bin/docker /usr/local/bin/docker
COPY scripts/entrypoint.sh /opt/opencode/native-contract.sh
COPY scripts/publish-plugins.mjs /opt/opencode/component/scripts/publish-plugins.mjs
COPY --chown=node:node .opencode/config/kdco /opt/opencode/component/.opencode/config/kdco/
COPY .opencode/config/plugins/kdco-*.ts /opt/opencode/component/.opencode/config/plugins/
USER node
RUN /bin/bash -c 'set -euo pipefail; source /opt/opencode/native-contract.sh; export OPENCODE_USER=node OPENCODE_UID="$(id -u)" OPENCODE_HOME=/opt/opencode/build-home OPENCODE_ROOT=/opt/opencode/component OPENCODE_PREFIX=/opt/opencode/component/.runtime OPENCODE_VERSION; install_runtime'
USER root
RUN test "$AGENT_UID" -gt 0 && test "$AGENT_GID" -gt 0 \
    && groupmod -n agent -g "$AGENT_GID" node \
    && usermod -l agent -u "$AGENT_UID" -g "$AGENT_GID" -d /home/agent node \
    && install -d -m 0700 -o agent -g agent /home/agent \
    && chmod -R a+rX,a-w /opt/opencode/component
COPY service-entrypoint.sh /opt/opencode/service-entrypoint.sh
ENV HOME=/home/agent USER=agent LOGNAME=agent \
    PATH=/opt/opencode/component/.runtime/bin:/usr/local/bin:/usr/bin:/bin \
    OPENCODE_DISABLE_AUTOUPDATE=1
USER agent
ENTRYPOINT ["/usr/bin/tini", "--", "/bin/bash", "/opt/opencode/service-entrypoint.sh"]
CMD ["opencode"]
