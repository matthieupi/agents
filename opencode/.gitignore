# Environment (contains secrets)
.env

# Workspace data
workspace/

# Session and auth data
data/

# Runtime cache (provider/plugin state)
cache/

# Workstation launcher lifecycle locks (never remove while launchers are active)
/.opencode/locks/

# Local overrides
docker-compose.override.yml

# Logs
*.log

# Native generated runtime and lifecycle state
/.runtime/
/.build.*/
/.lifecycle.lock

# Vendored source is public; installed dependencies are not source.
node_modules/
.kdco-install.*
