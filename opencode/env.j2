HOME={{ agent_home }}
USER={{ agent_account }}
LOGNAME={{ agent_account }}
XDG_CONFIG_HOME={{ agent_home }}/.config
XDG_DATA_HOME={{ agent_home }}/.local/share
XDG_STATE_HOME={{ agent_home }}/.local/state
XDG_CACHE_HOME={{ agent_home }}/.cache
OPENCODE_CONFIG_DIR={{ agent_home }}/.config/opencode
# Protected, single-line value supplied by the parent deployment. Never commit
# the rendered file; nginx must use this credential for the native upstream.
OPENCODE_PASSWORD={{ opencode_backend_password }}
{% if 'opencode' in (docker_access | default([])) %}
DOCKER_HOST=unix://{{ agent_docker_socket }}
{% endif %}
