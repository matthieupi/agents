#!/bin/bash
# OpenCode guided launcher - builds and runs the canonical opencode wrapper command.
set -euo pipefail

# Follow symlinks to find the real script directory.
SOURCE="${BASH_SOURCE[0]}"
while [[ -L "$SOURCE" ]]; do
    DIR="$(cd "$(dirname "$SOURCE")" && pwd)"
    SOURCE="$(readlink "$SOURCE")"
    [[ "$SOURCE" != /* ]] && SOURCE="$DIR/$SOURCE"
done
SCRIPT_DIR="$(cd "$(dirname "$SOURCE")" && pwd)"
OPENCODE_BIN="${SCRIPT_DIR}/opencode"

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

log_info() { echo -e "${GREEN}[opencode-menu]${NC} $*"; }
log_warn() { echo -e "${YELLOW}[opencode-menu]${NC} $*"; }
log_error() { echo -e "${RED}[opencode-menu]${NC} $*" >&2; }

require_gum() {
    if command -v gum > /dev/null 2>&1; then
        return 0
    fi

    log_error "The guided launcher requires 'gum'."
    cat >&2 <<'EOF'

Install gum, then retry:
  macOS:        brew install gum
  Arch Linux:   pacman -S gum
  Debian/Ubuntu:
    sudo mkdir -p /etc/apt/keyrings
    curl -fsSL https://repo.charm.sh/apt/gpg.key | sudo gpg --dearmor -o /etc/apt/keyrings/charm.gpg
    echo "deb [signed-by=/etc/apt/keyrings/charm.gpg] https://repo.charm.sh/apt/ * *" | sudo tee /etc/apt/sources.list.d/charm.list
    sudo apt update && sudo apt install gum

You can still use the normal CLI directly, for example:
  ./opencode --web 4096 --gpu 1 .
EOF
    exit 1
}

shell_quote_command() {
    printf '%q ' "$@"
    printf '\n'
}

show_help_block() {
    local title="$1"
    local body="$2"

    gum style --bold --foreground 212 "${title}"
    gum format "${body}"
}

show_workspace_help() {
    show_help_block "Workspace path" '
The project directory to mount into the OpenCode container.
Inside the container, this becomes /workspace.

Examples:
- .
- /home/me/projects/my-app
- ../some-repo

Default: .
'
}

show_port_help() {
    show_help_block "Web port" '
The host port used to access OpenCode in your browser.

Local web mode:
- http://localhost:<port>

LAN web mode:
- http://<machine-ip>:<port>

Default: 4096
'
}

show_gpu_help() {
    show_help_block "GPU devices" '
Which host GPU devices should be visible inside the OpenCode GPU container.

Examples:
- all   expose all GPUs
- 0     expose GPU device 0
- 1     expose GPU device 1
- 0,1   expose GPU devices 0 and 1

Default: all
'
}

show_dangerous_help() {
    show_help_block "Dangerous mode" '
Dangerous mode auto-approves OpenCode permission prompts.

Use it only in trusted workspaces where the agent may freely edit files and run commands.

Default: disabled
'
}

show_resource_help() {
    show_help_block "Container resources" '
CPU and memory limits are applied when Docker creates the OpenCode workspace container.

Examples:
- CPUs:   2, 4, 8, 8.0
- Memory: 4g, 8192m, 16g, 32g

Changing these values for an existing workspace container recreates that container because Docker startup limits are fixed at creation time.

Defaults:
- CPUs:   8.0
- Memory: 16g
'
}

show_publish_help() {
    show_help_block "Published ports" '
Publish extra host ports into the container so you can access dev servers started by the agent.

Examples:
- 3000                 host 3000 -> container 3000
- 5173:5173            host 5173 -> container 5173
- 127.0.0.1:8080:80    localhost 8080 -> container 80
- 0.0.0.0:8080:80      LAN 8080 -> container 80

The service inside the container must listen on 0.0.0.0, not just localhost.

Leave empty for no extra published ports. Separate multiple values with commas.
'
}

show_command_summary() {
    local mode="$1"
    local workspace="$2"
    local port="${3:-}"
    local gpu="${4:-}"
    local dangerous="${5:-no}"
    local cpus="${6:-8.0}"
    local memory="${7:-16g}"
    local publish="${8:-}"
    shift 8
    local -a cmd=("$@")

    gum style --bold --foreground 212 "Summary"
    printf 'Mode:       %s\n' "${mode}"
    printf 'Workspace:  %s\n' "${workspace}"
    [[ -n "${port}" ]] && printf 'Port:       %s\n' "${port}"
    [[ -n "${gpu}" ]] && printf 'GPU:        %s\n' "${gpu}"
    printf 'CPUs:       %s\n' "${cpus}"
    printf 'Memory:     %s\n' "${memory}"
    printf 'Publish:    %s\n' "${publish:-none}"
    printf 'Dangerous:  %s\n' "${dangerous}"
    printf '\n'

    gum style --bold --foreground 212 "Command"
    shell_quote_command "${cmd[@]}"
}

is_cpu_limit() {
    [[ "${1:-}" =~ ^[0-9]+([.][0-9]+)?$ ]] && awk "BEGIN { exit !($1 > 0) }"
}

is_memory_limit() {
    [[ "${1:-}" =~ ^[0-9]+([.][0-9]+)?[kKmMgG]?$ ]]
}

is_publish_spec() {
    [[ "${1:-}" =~ ^[0-9]+$ || "${1:-}" =~ ^[0-9]+:[0-9]+$ || "${1:-}" =~ ^(127\.0\.0\.1|0\.0\.0\.0):[0-9]+:[0-9]+$ ]]
}

prompt_workspace() {
    local current="${1:-.}"
    local workspace
    show_workspace_help
    workspace="$(gum input --value "${current}" --placeholder "Workspace path")"
    printf '%s' "${workspace:-.}"
}

prompt_port() {
    local current="${1:-4096}"
    local port
    show_port_help
    while true; do
        port="$(gum input --value "${current}" --placeholder "Port")"
        if [[ "${port}" =~ ^[0-9]+$ ]] && (( port >= 1 && port <= 65535 )); then
            printf '%s' "${port}"
            return 0
        fi
        gum style --foreground 196 "Port must be a number between 1 and 65535."
    done
}

prompt_gpu() {
    local current="${1:-all}"
    local choice custom
    show_gpu_help
    choice="$(gum choose "${current}" "all" "0" "1" "0,1" "custom")"
    if [[ "${choice}" == "custom" ]]; then
        custom="$(gum input --value "all" --placeholder "GPU devices: all, 0, 0,1")"
        printf '%s' "${custom:-all}"
    else
        printf '%s' "${choice}"
    fi
}

prompt_cpus() {
    local current="${1:-8.0}"
    local cpus
    show_resource_help
    while true; do
        cpus="$(gum input --value "${current}" --placeholder "CPUs, e.g. 4 or 8.0")"
        if is_cpu_limit "${cpus}"; then
            printf '%s' "${cpus}"
            return 0
        fi
        gum style --foreground 196 "CPUs must be a positive number, for example: 2, 4, or 8.0."
    done
}

prompt_memory() {
    local current="${1:-16g}"
    local memory
    show_resource_help
    while true; do
        memory="$(gum input --value "${current}" --placeholder "Memory, e.g. 8g or 16384m")"
        if is_memory_limit "${memory}"; then
            printf '%s' "${memory}"
            return 0
        fi
        gum style --foreground 196 "Memory must be a Docker memory value, for example: 4g, 8192m, or 16g."
    done
}

prompt_publish() {
    local current="${1:-}"
    local publish raw spec trimmed
    show_publish_help
    while true; do
        raw="$(gum input --value "${current}" --placeholder "Extra ports, e.g. 3000,5173:5173")"
        raw="${raw// /}"
        if [[ -z "${raw}" ]]; then
            printf '%s' ""
            return 0
        fi

        local valid="yes"
        IFS=',' read -ra specs <<< "${raw}"
        for spec in "${specs[@]}"; do
            trimmed="${spec// /}"
            if [[ -z "${trimmed}" ]] || ! is_publish_spec "${trimmed}"; then
                valid="no"
                break
            fi
        done

        if [[ "${valid}" == "yes" ]]; then
            printf '%s' "${raw}"
            return 0
        fi

        gum style --foreground 196 "Use comma-separated PORT, HOST_PORT:CONTAINER_PORT, or HOST_IP:HOST_PORT:CONTAINER_PORT values."
    done
}

mode_uses_port() {
    [[ "$1" == "Run Web UI" || "$1" == "Run Web UI on LAN" || "$1" == "Run Web UI + GPU" || "$1" == "Run Web UI on LAN + GPU" ]]
}

mode_uses_gpu() {
    [[ "$1" == "Run GPU TUI" || "$1" == "Run Web UI + GPU" || "$1" == "Run Web UI on LAN + GPU" ]]
}

mode_uses_lan() {
    [[ "$1" == "Run Web UI on LAN" || "$1" == "Run Web UI on LAN + GPU" ]]
}

build_run_args() {
    local mode="$1"
    local port="$2"
    local gpu="$3"
    local dangerous="$4"
    local cpus="$5"
    local memory="$6"
    local publish="$7"
    local -n out_args="$8"

    out_args=()

    case "${mode}" in
        "Run Web UI")
            out_args+=(--web "${port}")
            ;;
        "Run Web UI on LAN")
            out_args+=(--wlan "${port}")
            ;;
        "Run GPU TUI")
            out_args+=(--gpu "${gpu}")
            ;;
        "Run Web UI + GPU")
            out_args+=(--web "${port}" --gpu "${gpu}")
            ;;
        "Run Web UI on LAN + GPU")
            out_args+=(--wlan "${port}" --gpu "${gpu}")
            ;;
    esac

    if [[ "${dangerous}" == "yes" ]]; then
        out_args+=(--dangerous)
    fi

    out_args+=(--cpus "${cpus}" --memory "${memory}")

    if [[ -n "${publish}" ]]; then
        IFS=',' read -ra publish_specs <<< "${publish}"
        for publish_spec in "${publish_specs[@]}"; do
            out_args+=(--publish "${publish_spec}")
        done
    fi
}

choose_mode() {
    gum choose \
        "Run TUI" \
        "Run Web UI" \
        "Run Web UI on LAN" \
        "Run GPU TUI" \
        "Run Web UI + GPU" \
        "Run Web UI on LAN + GPU"
}

render_run_config() {
    local mode="$1"
    local workspace="$2"
    local port="$3"
    local gpu="$4"
    local dangerous="$5"
    local cpus="$6"
    local memory="$7"
    local publish="$8"
    shift 8
    local -a cmd=("$@")

    gum style --bold --foreground 212 "OpenCode Run Configuration"
    printf 'Mode:       %s\n' "${mode}"
    printf 'Workspace:  %s\n' "${workspace}"
    if mode_uses_port "${mode}"; then
        printf 'Port:       %s\n' "${port}"
    else
        printf 'Port:       n/a (only used for web modes)\n'
    fi
    if mode_uses_gpu "${mode}"; then
        printf 'GPU:        %s\n' "${gpu}"
    else
        printf 'GPU:        n/a\n'
    fi
    printf 'CPUs:       %s\n' "${cpus}"
    printf 'Memory:     %s\n' "${memory}"
    printf 'Publish:    %s\n' "${publish:-none}"
    printf 'Dangerous:  %s\n' "${dangerous}"
    printf '\n'
    gum style --bold --foreground 212 "Command"
    shell_quote_command "${cmd[@]}"
}

configure_run() {
    local mode="Run TUI"
    local workspace="."
    local port="4096"
    local gpu="all"
    local dangerous="no"
    local cpus="8.0"
    local memory="16g"
    local publish=""
    local action
    local -a args=()

    while true; do
        build_run_args "${mode}" "${port}" "${gpu}" "${dangerous}" "${cpus}" "${memory}" "${publish}" args
        render_run_config "${mode}" "${workspace}" "${port}" "${gpu}" "${dangerous}" "${cpus}" "${memory}" "${publish}" "${OPENCODE_BIN}" "${args[@]}" "${workspace}"

        action="$(gum choose \
            "Run" \
            "Edit mode" \
            "Edit workspace" \
            "Edit port" \
            "Edit GPU" \
            "Edit CPUs" \
            "Edit memory" \
            "Edit published ports" \
            "Toggle dangerous mode" \
            "Cancel")"

        case "${action}" in
            "Run")
                if mode_uses_lan "${mode}" && [[ -z "${OPENCODE_SERVER_PASSWORD:-}" ]]; then
                    gum style --foreground 214 "Warning: OPENCODE_SERVER_PASSWORD is not set; LAN mode will be exposed without auth."
                fi
                show_command_summary "${mode}" "${workspace}" "$(mode_uses_port "${mode}" && printf '%s' "${port}" || true)" "$(mode_uses_gpu "${mode}" && printf '%s' "${gpu}" || true)" "${dangerous}" "${cpus}" "${memory}" "${publish}" "${OPENCODE_BIN}" "${args[@]}" "${workspace}"
                if gum confirm "Run this command?"; then
                    exec "${OPENCODE_BIN}" "${args[@]}" "${workspace}"
                fi
                ;;
            "Edit mode")
                mode="$(choose_mode)"
                ;;
            "Edit workspace")
                workspace="$(prompt_workspace "${workspace}")"
                ;;
            "Edit port")
                port="$(prompt_port "${port}")"
                ;;
            "Edit GPU")
                gpu="$(prompt_gpu "${gpu}")"
                ;;
            "Edit CPUs")
                cpus="$(prompt_cpus "${cpus}")"
                ;;
            "Edit memory")
                memory="$(prompt_memory "${memory}")"
                ;;
            "Edit published ports")
                publish="$(prompt_publish "${publish}")"
                ;;
            "Toggle dangerous mode")
                show_dangerous_help
                if [[ "${dangerous}" == "yes" ]]; then
                    dangerous="no"
                else
                    dangerous="yes"
                fi
                ;;
            "Cancel")
                log_info "Cancelled."
                return 0
                ;;
        esac
    done
}

run_generated_command() {
    local -a cmd=("$@")

    gum style --bold --foreground 212 "Command"
    shell_quote_command "${cmd[@]}"

    if gum confirm "Run this command?"; then
        exec "${cmd[@]}"
    fi

    log_info "Cancelled."
}

select_container() {
    local selected
    mapfile -t containers < <(docker ps -a --filter "name=opencode-" --format "{{.Names}}\t{{.Status}}" 2>/dev/null || true)

    if [[ ${#containers[@]} -eq 0 ]]; then
        gum style --foreground 214 "No opencode-* containers found."
        return 1
    fi

    show_help_block "Container selection" '
Select an existing opencode workspace container.

The menu shows each container name and Docker status. The selected container name is passed to the normal ./opencode management command.
'

    selected="$(printf '%s\n' "${containers[@]}" | gum choose --height 12)"
    [[ -n "${selected}" ]] || return 1
    printf '%s' "${selected%%$'\t'*}"
}

manage_containers() {
    local action target
    gum style --bold --foreground 212 "Manage Containers"
    gum style --foreground 245 "List, select, inspect, clean, or open shells for opencode workspace containers."

    action="$(gum choose \
        "List containers" \
        "Select container" \
        "Rebuild CPU image" \
        "Rebuild GPU image" \
        "Rebuild all images" \
        "Stop container" \
        "Stop all containers" \
        "Clean stopped containers" \
        "Force clean all containers" \
        "Open container shell" \
        "Show container logs")"

    case "${action}" in
        "List containers")
            run_generated_command "${OPENCODE_BIN}" list
            ;;
        "Select container")
            target="$(select_container)" || exit 0
            local container_action
            container_action="$(gum choose \
                "Open shell" \
                "Show logs" \
                "Stop" \
                "Remove")"
            case "${container_action}" in
                "Open shell") run_generated_command "${OPENCODE_BIN}" shell "${target}" ;;
                "Show logs") run_generated_command "${OPENCODE_BIN}" logs "${target}" ;;
                "Stop") run_generated_command "${OPENCODE_BIN}" stop "${target}" ;;
                "Remove") run_generated_command "${OPENCODE_BIN}" remove "${target}" ;;
            esac
            ;;
        "Rebuild CPU image")
            run_generated_command "${OPENCODE_BIN}" rebuild
            ;;
        "Rebuild GPU image")
            run_generated_command "${OPENCODE_BIN}" rebuild gpu
            ;;
        "Rebuild all images")
            run_generated_command "${OPENCODE_BIN}" rebuild all
            ;;
        "Stop container")
            target="$(select_container)" || exit 0
            run_generated_command "${OPENCODE_BIN}" stop "${target}"
            ;;
        "Stop all containers")
            run_generated_command "${OPENCODE_BIN}" stop all
            ;;
        "Clean stopped containers")
            run_generated_command "${OPENCODE_BIN}" clean
            ;;
        "Force clean all containers")
            run_generated_command "${OPENCODE_BIN}" fclean
            ;;
        "Open container shell")
            target="$(select_container)" || exit 0
            run_generated_command "${OPENCODE_BIN}" shell "${target}"
            ;;
        "Show container logs")
            target="$(select_container)" || exit 0
            run_generated_command "${OPENCODE_BIN}" logs "${target}"
            ;;
    esac
}

main() {
    require_gum

    gum style --bold --foreground 212 "OpenCode Launcher"
    gum style --foreground 245 "Guided command builder for the containerized OpenCode wrapper."

    local mode

    mode="$(gum choose \
        "Configure and Run" \
        "Rebuild Images" \
        "Manage Containers")"

    case "${mode}" in
        "Configure and Run")
            configure_run
            return 0
            ;;
        "Manage Containers")
            manage_containers
            return 0
            ;;
        "Rebuild Images")
            local target
            target="$(gum choose "CPU image" "GPU image" "All images")"
            case "${target}" in
                "CPU image") run_generated_command "${OPENCODE_BIN}" rebuild ;;
                "GPU image") run_generated_command "${OPENCODE_BIN}" rebuild gpu ;;
                "All images") run_generated_command "${OPENCODE_BIN}" rebuild all ;;
            esac
            return 0
            ;;
    esac
}

main "$@"
