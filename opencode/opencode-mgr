#!/bin/bash
# OpenCode Container Manager
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CPU_IMAGE_NAME="lab/opencode:latest"
GPU_IMAGE_NAME="lab/opencode:gpu"

GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
NC='\033[0m'

log_info() { echo -e "${GREEN}[opencode-mgr]${NC} $*"; }
log_warn() { echo -e "${YELLOW}[opencode-mgr]${NC} $*"; }
log_error() { echo -e "${RED}[opencode-mgr]${NC} $*" >&2; }
source "${SCRIPT_DIR}/scripts/workstation-common.sh"

# Show usage
usage() {
    cat << EOF
OpenCode Container Manager

Usage: $(basename "$0") <command> [options]

Commands:
    list, ls              List this checkout/user's owned workstation containers
    rebuild, update       Rebuild CPU image and refresh containers
    rebuild gpu           Rebuild GPU CUDA devel image and refresh containers
    rebuild all           Rebuild CPU and GPU images and refresh containers
    stop <name|all>       Stop container(s)
    start <name>          Start a stopped container
    remove, rm <name|all> Remove container(s)
    clean [-f]            Remove stopped containers (-f: stop all first)
    fclean                Force clean: stop all containers, then remove
    logs <name>           Show container logs
    shell <name>          Open bash shell in container

Examples:
    $(basename "$0") list
    $(basename "$0") rebuild
    $(basename "$0") rebuild gpu
    $(basename "$0") rebuild all
    $(basename "$0") stop opencode-myproject
    $(basename "$0") stop all
    $(basename "$0") clean
All management commands exclude unowned containers and Compose services.
Rebuild does not reset private state or credentials. Unlabelled legacy containers
are preserved; review their ownership separately before removing them manually.
EOF
    exit 0
}

# List all opencode containers
list_containers() {
    log_info "OpenCode containers:"
    local ids container
    ids="$(workstation_ids -aq)"
    for container in $ids; do
        docker inspect --format '{{.Name}} {{.State.Status}}' "$container"
    done
}

# Stop containers
stop_containers() {
    local target="${1:-}"
    if [[ -z "$target" ]]; then
        log_error "Specify container name or 'all'"
        exit 1
    fi

    if [[ "$target" == "all" ]]; then
        log_info "Stopping all opencode containers..."
        local ids
        ids="$(workstation_ids -q)"
        [[ -z "$ids" ]] || docker stop $ids
    else
        log_info "Stopping container: $target"
        workstation_owned "$target" || { log_error 'Not an owned workstation container'; exit 1; }
        docker stop "$target"
    fi
}

# Start container
start_container() {
    local name="${1:-}"
    if [[ -z "$name" ]]; then
        log_error "Specify container name"
        exit 1
    fi

    log_info "Starting container: $name"
    workstation_owned "$name" || { log_error 'Not an owned workstation container'; exit 1; }
    docker start "$name"
}

# Remove containers
remove_containers() {
    local target="${1:-}"
    if [[ -z "$target" ]]; then
        log_error "Specify container name or 'all'"
        exit 1
    fi

    if [[ "$target" == "all" ]]; then
        log_warn "Removing all opencode containers..."
        read -p "Are you sure? (y/N) " -n 1 -r
        echo
        if [[ $REPLY =~ ^[Yy]$ ]]; then
            local ids
            ids="$(workstation_ids -aq)"
            [[ -z "$ids" ]] || docker rm -f $ids
        fi
    else
        log_info "Removing container: $target"
        workstation_owned "$target" || { log_error 'Not an owned workstation container'; exit 1; }
        docker rm -f "$target"
    fi
}

# Clean stopped containers
clean_containers() {
    local force="${1:-}"
    local ids

    if [[ "$force" == "-f" ]]; then
        log_warn "Force clean: stopping all opencode containers first..."
        ids="$(workstation_ids -q)"
        [[ -z "$ids" ]] || docker stop $ids
    fi

    log_info "Removing stopped opencode containers..."
    ids="$(workstation_ids -aq --filter status=exited)"
    [[ -z "$ids" ]] || docker rm $ids
}

# Show logs
show_logs() {
    local name="${1:-}"
    if [[ -z "$name" ]]; then
        log_error "Specify container name"
        exit 1
    fi

    workstation_owned "$name" || { log_error 'Not an owned workstation container'; exit 1; }
    docker logs -f "$name"
}

# Open shell
open_shell() {
    local name="${1:-}"
    if [[ -z "$name" ]]; then
        log_error "Specify container name"
        exit 1
    fi

    workstation_owned "$name" || { log_error 'Not an owned workstation container'; exit 1; }
    docker exec -it -e OPENCODE_EXPERIMENTAL_WORKSPACES=1 "$name" /bin/bash
}

rebuild_cpu_image() {
    workstation_local
    log_info "Rebuilding ${CPU_IMAGE_NAME} from local workspace..."
    docker build --pull --build-arg "LOCAL_UID=$WORKSTATION_UID" --build-arg "LOCAL_GID=$WORKSTATION_GID" -t "${CPU_IMAGE_NAME}" "${SCRIPT_DIR}"
    log_info "CPU image rebuilt successfully"
}

rebuild_gpu_image() {
    workstation_local
    log_info "Rebuilding ${GPU_IMAGE_NAME} from local workspace..."
    docker build --pull --build-arg "LOCAL_UID=$WORKSTATION_UID" --build-arg "LOCAL_GID=$WORKSTATION_GID" -f "${SCRIPT_DIR}/Dockerfile.gpu" -t "${GPU_IMAGE_NAME}" "${SCRIPT_DIR}"
    log_info "GPU image rebuilt successfully"
}

refresh_workspace_containers() {
    local scope="${1:-existing opencode workspace}"

    local container_ids
    container_ids="$(workstation_ids -aq)"
    if [[ -n "${container_ids}" ]]; then
        log_warn "Refreshing ${scope} containers..."
        docker rm -f ${container_ids} > /dev/null
        log_info "Containers removed. They will be recreated on next run."
    else
        log_info "No existing opencode workspace containers to refresh."
    fi
}

rebuild_image() {
    local target="${1:-cpu}"

    case "${target}" in
        cpu|"")
            rebuild_cpu_image
            ;;
        gpu)
            rebuild_gpu_image
            ;;
        all)
            rebuild_cpu_image
            rebuild_gpu_image
            ;;
        *)
            log_error "Unknown rebuild target: ${target}"
            log_error "Expected: cpu, gpu, or all"
            exit 1
            ;;
    esac

    refresh_workspace_containers "opencode workspace"
}

# Main command router
CMD="${1:-}"
case "$CMD" in
    list|ls)
        list_containers
        ;;
    rebuild|update)
        rebuild_image "${2:-cpu}"
        ;;
    stop)
        stop_containers "${2:-}"
        ;;
    start)
        start_container "${2:-}"
        ;;
    remove|rm)
        remove_containers "${2:-}"
        ;;
    clean)
        clean_containers "${2:-}"
        ;;
    fclean)
        clean_containers "-f"
        ;;
    logs)
        show_logs "${2:-}"
        ;;
    shell)
        open_shell "${2:-}"
        ;;
    help|--help|-h|"")
        usage
        ;;
    *)
        log_error "Unknown command: $CMD"
        usage
        ;;
esac
