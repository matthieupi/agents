{
  "name": "opencode-ssh-remote",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "index.js",
  "engines": { "node": ">=22" },
  "scripts": {
    "test": "node --test tests/*.test.js",
    "test:helper": "python3 -B -m unittest discover -s tests -p test_remote_helper.py -v",
    "test:schema": "VERIFY_PUBLIC_SCHEMA=1 node --test tests/schema.test.js",
    "test:loader": "VERIFY_OPENCODE_SOURCE=1 node --test tests/startup-lockdown.test.js",
    "test:engine": "node --test --test-name-pattern='native binary|isolated native|positive native' tests/startup-lockdown.test.js tests/native-engine.test.js"
  },
  "dependencies": { "@opencode-ai/plugin": "1.18.29", "ssh2": "1.17.0" }
}
