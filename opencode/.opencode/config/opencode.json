{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-6-astra",
  "update": "disable",
  "compaction": { "auto": false, "buffer": 50000 },
  "lsp": true,
  "plugins": [],
  "agents": {
    "title": { "model": "openai/gpt-5-mini" },
    "Orchestrator": {
      "system": "{file:./system/orchestrator.md}",
      "model": "openai/gpt-6-astra",
      "mode": "primary",
      "description": "Accountable delivery lead coordinating subagents, dependencies, reviews, and evidence-based acceptance",
      "permissions": [
        { "action": "read", "resource": "*", "effect": "allow" },
        { "action": "glob", "resource": "*", "effect": "allow" },
        { "action": "grep", "resource": "*", "effect": "allow" },
        { "action": "list", "resource": "*", "effect": "allow" },
        { "action": "question", "resource": "*", "effect": "allow" },
        { "action": "todowrite", "resource": "*", "effect": "allow" },
        { "action": "subagent", "resource": "*", "effect": "allow" },
        { "action": "skill", "resource": "*", "effect": "allow" },
        { "action": "webfetch", "resource": "*", "effect": "allow" },
        { "action": "edit", "resource": "*", "effect": "allow" },
        { "action": "shell", "resource": "*", "effect": "allow" }
      ]
    },
    "explore": {
      "system": "{file:./system/explore.md}",
      "request": { "body": { "temperature": 0.1 } },
      "mode": "all",
      "description": "Read-only codebase exploration and discovery",
      "permissions": [
        { "action": "read", "resource": "*", "effect": "allow" },
        { "action": "glob", "resource": "*", "effect": "allow" },
        { "action": "grep", "resource": "*", "effect": "allow" },
        { "action": "list", "resource": "*", "effect": "allow" },
        { "action": "shell", "resource": "*", "effect": "allow" },
        { "action": "subagent", "resource": "*", "effect": "allow" },
        { "action": "webfetch", "resource": "*", "effect": "allow" },
        { "action": "edit", "resource": "*", "effect": "deny" }
      ]
    },
    "reviewer": {
      "system": "{file:./system/reviewer.md}",
      "request": { "body": { "temperature": 0.2 } },
      "mode": "all",
      "description": "Architecture and code review focused on simplification and elegance",
      "permissions": [
        { "action": "read", "resource": "*", "effect": "allow" },
        { "action": "glob", "resource": "*", "effect": "allow" },
        { "action": "grep", "resource": "*", "effect": "allow" },
        { "action": "list", "resource": "*", "effect": "allow" },
        { "action": "shell", "resource": "*", "effect": "allow" },
        { "action": "subagent", "resource": "*", "effect": "allow" },
        { "action": "webfetch", "resource": "*", "effect": "allow" },
        { "action": "edit", "resource": "*", "effect": "ask" }
      ]
    },
    "COO": {
      "system": "{file:./system/coo.md}",
      "request": { "body": { "temperature": 0.2 } },
      "mode": "all",
      "description": "Execution-first operating partner for priorities, decisions, coordination, and delivery",
      "permissions": [
        { "action": "read", "resource": "*", "effect": "allow" },
        { "action": "glob", "resource": "*", "effect": "allow" },
        { "action": "grep", "resource": "*", "effect": "allow" },
        { "action": "list", "resource": "*", "effect": "allow" },
        { "action": "question", "resource": "*", "effect": "allow" },
        { "action": "todowrite", "resource": "*", "effect": "allow" },
        { "action": "subagent", "resource": "*", "effect": "allow" },
        { "action": "skill", "resource": "*", "effect": "allow" },
        { "action": "webfetch", "resource": "*", "effect": "allow" },
        { "action": "shell", "resource": "*", "effect": "allow" },
        { "action": "edit", "resource": "*", "effect": "allow" }
      ]
    },
    "DevOps": {
      "system": "{file:./system/devops.md}",
      "model": "openai/gpt-6-astra",
      "request": { "body": { "temperature": 0.2 } },
      "mode": "all",
      "description": "Gilfoyle: secure infrastructure, deployment, reliability, and operations engineering"
    },
    "DevOps Junior": {
      "system": "{file:./system/devops.md}",
      "model": "openai/gpt-6-sol",
      "request": { "body": { "temperature": 0.2 } },
      "mode": "subagent",
      "hidden": true,
      "description": "DevOps specialist for delegated, moderately complex infrastructure and operations tasks that require some thinking and analysis"
    },
    "SecOps": {
      "system": "{file:./system/secops.md}",
      "request": { "body": { "temperature": 0.1 } },
      "mode": "all",
      "description": "Dan: security hardening, green and red teaming, vulnerability auditing, and remediation"
    },
    "plan": {
      "system": "{file:./system/plan.md}",
      "request": { "body": { "temperature": 0.2 } },
      "mode": "all",
      "description": "Creates saved implementation plans under .project"
    },
    "build": {
      "system": "{file:./system/build.md}",
      "request": { "body": { "temperature": 0.3 } },
      "mode": "all",
      "description": "Implements code changes with stepwise verification"
    },
    "worker": {
      "system": "{file:./system/worker.md}",
      "model": "openai/gpt-6-luna",
      "mode": "subagent",
      "description": "Executes simple, well-scoped tasks with focused changes and verification",
      "permissions": [
        { "action": "subagent", "resource": "*", "effect": "deny" }
      ]
    },
    "plan-inline": {
      "system": "{file:./system/plan-inline.md}",
      "request": { "body": { "temperature": 0.2 } },
      "mode": "all",
      "description": "Creates detailed concrete implementation plans inline without writing files"
    }
  },
  "permissions": [{ "action": "*", "resource": "*", "effect": "allow" }],
  "providers": {
    "anthropic": { "settings": { "apiKey": "{env:ANTHROPIC_API_KEY}" } },
    "openai": {
      "settings": { "apiKey": "{env:OPENAI_API_KEY}" },
      "models": {
        "gpt-6-astra": { "limit": { "context": 1050000, "input": 320000, "output": 128000 } },
        "gpt-6.1-sol": { "limit": { "context": 1050000, "input": 320000, "output": 128000 } }
      }
    },
    "ollama": {
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": { "baseURL": "{env:OLLAMA_HOST}/v1" },
      "models": {
        "qwen2.5-coder:32b": {
          "name": "Qwen 2.5 Coder 32B",
          "limit": { "context": 32768, "output": 8192 }
        },
        "deepseek-coder-v2:latest": {
          "name": "DeepSeek Coder V2",
          "limit": { "context": 131072, "output": 8192 }
        }
      }
    }
  }
}
