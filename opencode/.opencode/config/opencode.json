{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-6-astra",
  "small_model": "openai/gpt-5-mini",
  "lsp": true,
  "plugin": [],
  "agent": {
    "Orchestrator": {
      "prompt": "{file:./system/orchestrator.md}",
      "model": "openai/gpt-6-astra",
      "mode": "primary",
      "description": "Accountable delivery lead coordinating subagents, dependencies, reviews, and evidence-based acceptance",
      "permission": {
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "question": "allow",
        "todowrite": "allow",
        "task": "allow",
        "skill": "allow",
        "webfetch": "allow",
        "edit": "allow",
        "bash": "allow"
      }
    },
    "explore": {
      "prompt": "{file:./system/explore.md}",
      "temperature": 0.1,
      "mode": "all",
      "description": "Read-only codebase exploration and discovery",
      "permission": {
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "bash": "allow",
        "task": "allow",
        "webfetch": "allow",
        "edit": "deny"
      }
    },
    "reviewer": {
      "prompt": "{file:./system/reviewer.md}",
      "temperature": 0.2,
      "mode": "all",
      "description": "Architecture and code review focused on simplification and elegance",
      "permission": {
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "bash": "allow",
        "task": "allow",
        "webfetch": "allow",
        "edit": "ask"
      }
    },
    "COO": {
      "prompt": "{file:./system/coo.md}",
      "temperature": 0.2,
      "mode": "all",
      "description": "Execution-first operating partner for priorities, decisions, coordination, and delivery",
      "permission": {
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "question": "allow",
        "todowrite": "allow",
        "task": "allow",
        "skill": "allow",
        "webfetch": "allow",
        "bash": "allow",
        "edit": "allow"
      }
    },
    "DevOps": {
      "prompt": "{file:./system/devops.md}",
      "model": "openai/gpt-6-astra",
      "temperature": 0.2,
      "mode": "all",
      "description": "Gilfoyle: secure infrastructure, deployment, reliability, and operations engineering"
    },
    "DevOps Junior": {
      "prompt": "{file:./system/devops.md}",
      "model": "openai/gpt-6-sol",
      "temperature": 0.2,
      "mode": "subagent",
      "hidden": true,
      "description": "DevOps specialist for delegated, moderately complex infrastructure and operations tasks that require some thinking and analysis"
    },
    "SecOps": {
      "prompt": "{file:./system/secops.md}",
      "temperature": 0.1,
      "mode": "all",
      "description": "Dan: security hardening, green and red teaming, vulnerability auditing, and remediation"
    },
    "plan": {
      "prompt": "{file:./system/plan.md}",
      "temperature": 0.2,
      "mode": "all",
      "description": "Creates saved implementation plans under .project"
    },
    "build": {
      "prompt": "{file:./system/build.md}",
      "temperature": 0.3,
      "mode": "all",
      "description": "Implements code changes with stepwise verification"
    },
    "plan-inline": {
      "prompt": "{file:./system/plan-inline.md}",
      "temperature": 0.2,
      "mode": "all",
      "description": "Creates detailed concrete implementation plans inline without writing files"
    }
  },
  "permission": "allow",
  "provider": {
    "anthropic": {
      "options": {
        "apiKey": "{env:ANTHROPIC_API_KEY}"
      }
    },
    "openai": {
      "options": {
        "apiKey": "{env:OPENAI_API_KEY}"
      }
    },
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "{env:OLLAMA_HOST}/v1"
      },
      "models": {
        "qwen2.5-coder:32b": {
          "name": "Qwen 2.5 Coder 32B",
          "limit": { "context": 32768, "output": 8192 }
        },
        "deepseek-coder-v2:latest": {
          "name": "DeepSeek Coder V2",
          "limit": { "context": 131072, "output": 8192 }
        }
      }
    }
  }
}
