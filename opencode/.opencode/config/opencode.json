{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-6",
  "update": "disable",
  "compaction": { "auto": false, "buffer": 50000 },
  "lsp": true,
  "plugins": [],
  "agents": {
    "title": { "model": "openai/gpt-5-mini" },
    "Orchestrator": {
      "system": "{file:./system/orchestrator.md}",
      "model": "openai/gpt-6-astra",
      "mode": "primary",
      "description": "Accountable delivery lead coordinating subagents, dependencies, reviews, and evidence-based acceptance",
      "permissions": [
        { "action": "read", "resource": "*", "effect": "allow" },
        { "action": "glob", "resource": "*", "effect": "allow" },
        { "action": "grep", "resource": "*", "effect": "allow" },
        { "action": "list", "resource": "*", "effect": "allow" },
        { "action": "question", "resource": "*", "effect": "allow" },
        { "action": "todowrite", "resource": "*", "effect": "allow" },
        { "action": "subagent", "resource": "*", "effect": "allow" },
        { "action": "skill", "resource": "*", "effect": "allow" },
        { "action": "webfetch", "resource": "*", "effect": "allow" },
        { "action": "edit", "resource": "*", "effect": "allow" },
        { "action": "shell", "resource": "*", "effect": "allow" }
      ]
    },
    "explore": {
      "system": "{file:./system/explore.md}",
      "request": { "body": { "temperature": 0.1 } },
      "mode": "all",
      "description": "Read-only codebase exploration and discovery",
      "permissions": [
        { "action": "read", "resource": "*", "effect": "allow" },
        { "action": "glob", "resource": "*", "effect": "allow" },
        { "action": "grep", "resource": "*", "effect": "allow" },
        { "action": "list", "resource": "*", "effect": "allow" },
        { "action": "shell", "resource": "*", "effect": "allow" },
        { "action": "subagent", "resource": "*", "effect": "allow" },
        { "action": "webfetch", "resource": "*", "effect": "allow" },
        { "action": "edit", "resource": "*", "effect": "deny" }
      ]
    },
    "reviewer": {
      "system": "{file:./system/reviewer.md}",
      "request": { "body": { "temperature": 0.2 } },
      "mode": "all",
      "description": "Architecture and code review focused on simplification and elegance",
      "permissions": [
        { "action": "read", "resource": "*", "effect": "allow" },
        { "action": "glob", "resource": "*", "effect": "allow" },
        { "action": "grep", "resource": "*", "effect": "allow" },
        { "action": "list", "resource": "*", "effect": "allow" },
        { "action": "shell", "resource": "*", "effect": "allow" },
        { "action": "subagent", "resource": "*", "effect": "allow" },
        { "action": "webfetch", "resource": "*", "effect": "allow" },
        { "action": "edit", "resource": "*", "effect": "ask" }
      ]
    },
    "COO": {
      "system": "{file:./system/coo.md}",
      "request": { "body": { "temperature": 0.2 } },
      "mode": "all",
      "description": "Execution-first operating partner for priorities, decisions, coordination, and delivery",
      "permissions": [
        { "action": "read", "resource": "*", "effect": "allow" },
        { "action": "glob", "resource": "*", "effect": "allow" },
        { "action": "grep", "resource": "*", "effect": "allow" },
        { "action": "list", "resource": "*", "effect": "allow" },
        { "action": "question", "resource": "*", "effect": "allow" },
        { "action": "todowrite", "resource": "*", "effect": "allow" },
        { "action": "subagent", "resource": "*", "effect": "allow" },
        { "action": "skill", "resource": "*", "effect": "allow" },
        { "action": "webfetch", "resource": "*", "effect": "allow" },
        { "action": "shell", "resource": "*", "effect": "allow" },
        { "action": "edit", "resource": "*", "effect": "allow" }
      ]
    },
    "DevOps": {
      "system": "{file:./system/devops.md}",
      "model": "openai/gpt-6-astra",
      "request": { "body": { "temperature": 0.2 } },
      "mode": "primary",
      "description": "Gilfoyle: secure infrastructure, deployment, reliability, and operations engineering"
    },
    "DevOps Medium": {
      "system": "{file:./system/devops.md}",
      "model": "openai/gpt-5.6-sol",
      "request": { "body": { "temperature": 0.2 } },
      "mode": "subagent",
      "hidden": true,
      "description": "DevOps specialist for delegated, moderately complex infrastructure and operations tasks that require some thinking and analysis"
    },
    "DevOps Low": {
      "system": "{file:./system/devops.md}",
      "model": "openai/gpt-5.6-terra",
      "request": { "body": { "temperature": 0.2 } },
      "mode": "subagent",
      "hidden": true,
      "description": "DevOps specialist for delegated simple, narrowly scoped infrastructure and operations tasks that can be executed quickly"
    },
    "SecOps": {
      "system": "{file:./system/secops.md}",
      "request": { "body": { "temperature": 0.1 } },
      "mode": "all",
      "description": "Dan: security hardening, green and red teaming, vulnerability auditing, and remediation"
    },
    "gsd-planner": {
      "system": "{file:./gsd/planner.md}",
      "request": { "body": { "temperature": 0.2 } },
      "mode": "all",
      "description": "GSD phase and quick-task planner",
      "permissions": [
        { "action": "read", "resource": "*", "effect": "allow" },
        { "action": "glob", "resource": "*", "effect": "allow" },
        { "action": "grep", "resource": "*", "effect": "allow" },
        { "action": "list", "resource": "*", "effect": "allow" },
        { "action": "shell", "resource": "*", "effect": "allow" },
        { "action": "subagent", "resource": "*", "effect": "allow" },
        { "action": "webfetch", "resource": "*", "effect": "allow" },
        { "action": "edit", "resource": "*", "effect": "allow" }
      ]
    },
    "gsd-phase-researcher": {
      "system": "{file:./gsd/phase-researcher.md}",
      "request": { "body": { "temperature": 0.2 } },
      "mode": "subagent",
      "description": "Researches GSD roadmap phases before planning",
      "permissions": [
        { "action": "read", "resource": "*", "effect": "allow" },
        { "action": "glob", "resource": "*", "effect": "allow" },
        { "action": "grep", "resource": "*", "effect": "allow" },
        { "action": "list", "resource": "*", "effect": "allow" },
        { "action": "shell", "resource": "*", "effect": "ask" },
        { "action": "webfetch", "resource": "*", "effect": "allow" },
        { "action": "edit", "resource": "*", "effect": "ask" }
      ]
    },
    "gsd-plan-checker": {
      "system": "{file:./gsd/plan-checker.md}",
      "request": { "body": { "temperature": 0.1 } },
      "mode": "subagent",
      "description": "Verifies generated GSD plans for executability and coverage",
      "permissions": [
        { "action": "read", "resource": "*", "effect": "allow" },
        { "action": "glob", "resource": "*", "effect": "allow" },
        { "action": "grep", "resource": "*", "effect": "allow" },
        { "action": "list", "resource": "*", "effect": "allow" },
        { "action": "shell", "resource": "*", "effect": "ask" },
        { "action": "edit", "resource": "*", "effect": "deny" }
      ]
    },
    "gsd-executor": {
      "system": "{file:./gsd/executor.md}",
      "request": { "body": { "temperature": 0.2 } },
      "mode": "subagent",
      "description": "Executes GSD plans and writes implementation summaries",
      "permissions": [
        { "action": "read", "resource": "*", "effect": "allow" },
        { "action": "glob", "resource": "*", "effect": "allow" },
        { "action": "grep", "resource": "*", "effect": "allow" },
        { "action": "list", "resource": "*", "effect": "allow" },
        { "action": "shell", "resource": "*", "effect": "allow" },
        { "action": "subagent", "resource": "*", "effect": "allow" },
        { "action": "webfetch", "resource": "*", "effect": "allow" },
        { "action": "edit", "resource": "*", "effect": "allow" }
      ]
    },
    "gsd-verifier": {
      "system": "{file:./gsd/verifier.md}",
      "request": { "body": { "temperature": 0.2 } },
      "mode": "subagent",
      "description": "Verifies completed GSD phases against goals and requirements",
      "permissions": [
        { "action": "read", "resource": "*", "effect": "allow" },
        { "action": "glob", "resource": "*", "effect": "allow" },
        { "action": "grep", "resource": "*", "effect": "allow" },
        { "action": "list", "resource": "*", "effect": "allow" },
        { "action": "shell", "resource": "*", "effect": "ask" },
        { "action": "edit", "resource": "*", "effect": "ask" }
      ]
    },
    "gsd-project-researcher": {
      "system": "{file:./gsd/project-researcher.md}",
      "request": { "body": { "temperature": 0.2 } },
      "mode": "subagent",
      "description": "Researches project dimensions for GSD project and milestone setup",
      "permissions": [
        { "action": "read", "resource": "*", "effect": "allow" },
        { "action": "glob", "resource": "*", "effect": "allow" },
        { "action": "grep", "resource": "*", "effect": "allow" },
        { "action": "list", "resource": "*", "effect": "allow" },
        { "action": "shell", "resource": "*", "effect": "ask" },
        { "action": "webfetch", "resource": "*", "effect": "allow" },
        { "action": "edit", "resource": "*", "effect": "ask" }
      ]
    },
    "gsd-research-synthesizer": {
      "system": "{file:./gsd/research-synthesizer.md}",
      "request": { "body": { "temperature": 0.2 } },
      "mode": "subagent",
      "description": "Synthesizes GSD research into planning inputs",
      "permissions": [
        { "action": "read", "resource": "*", "effect": "allow" },
        { "action": "glob", "resource": "*", "effect": "allow" },
        { "action": "grep", "resource": "*", "effect": "allow" },
        { "action": "list", "resource": "*", "effect": "allow" },
        { "action": "shell", "resource": "*", "effect": "ask" },
        { "action": "edit", "resource": "*", "effect": "ask" }
      ]
    },
    "gsd-roadmapper": {
      "system": "{file:./gsd/roadmapper.md}",
      "request": { "body": { "temperature": 0.2 } },
      "mode": "subagent",
      "description": "Creates and revises GSD roadmaps",
      "permissions": [
        { "action": "read", "resource": "*", "effect": "allow" },
        { "action": "glob", "resource": "*", "effect": "allow" },
        { "action": "grep", "resource": "*", "effect": "allow" },
        { "action": "list", "resource": "*", "effect": "allow" },
        { "action": "shell", "resource": "*", "effect": "ask" },
        { "action": "edit", "resource": "*", "effect": "ask" }
      ]
    },
    "gsd-integration-checker": {
      "system": "{file:./gsd/integration-checker.md}",
      "request": { "body": { "temperature": 0.1 } },
      "mode": "subagent",
      "description": "Audits GSD milestone integration and end-to-end gaps",
      "permissions": [
        { "action": "read", "resource": "*", "effect": "allow" },
        { "action": "glob", "resource": "*", "effect": "allow" },
        { "action": "grep", "resource": "*", "effect": "allow" },
        { "action": "list", "resource": "*", "effect": "allow" },
        { "action": "shell", "resource": "*", "effect": "ask" },
        { "action": "edit", "resource": "*", "effect": "ask" }
      ]
    },
    "gsd-debugger": {
      "system": "{file:./gsd/debugger.md}",
      "request": { "body": { "temperature": 0.1 } },
      "mode": "subagent",
      "description": "Investigates GSD debug sessions with persistent evidence",
      "permissions": [
        { "action": "read", "resource": "*", "effect": "allow" },
        { "action": "glob", "resource": "*", "effect": "allow" },
        { "action": "grep", "resource": "*", "effect": "allow" },
        { "action": "list", "resource": "*", "effect": "allow" },
        { "action": "shell", "resource": "*", "effect": "allow" },
        { "action": "edit", "resource": "*", "effect": "ask" }
      ]
    },
    "gsd-entity-generator": {
      "system": "{file:./gsd/entity-generator.md}",
      "request": { "body": { "temperature": 0.1 } },
      "mode": "subagent",
      "description": "Generates GSD codebase intelligence entities",
      "permissions": [
        { "action": "read", "resource": "*", "effect": "allow" },
        { "action": "glob", "resource": "*", "effect": "allow" },
        { "action": "grep", "resource": "*", "effect": "allow" },
        { "action": "list", "resource": "*", "effect": "allow" },
        { "action": "shell", "resource": "*", "effect": "ask" },
        { "action": "edit", "resource": "*", "effect": "ask" }
      ]
    },
    "gsd-codebase-mapper": {
      "system": "{file:./gsd/codebase-mapper.md}",
      "request": { "body": { "temperature": 0.1 } },
      "mode": "subagent",
      "description": "Maps codebase structure into GSD planning documents",
      "permissions": [
        { "action": "read", "resource": "*", "effect": "allow" },
        { "action": "glob", "resource": "*", "effect": "allow" },
        { "action": "grep", "resource": "*", "effect": "allow" },
        { "action": "list", "resource": "*", "effect": "allow" },
        { "action": "shell", "resource": "*", "effect": "ask" },
        { "action": "edit", "resource": "*", "effect": "ask" }
      ]
    },
    "plan": {
      "system": "{file:./system/plan.md}",
      "request": { "body": { "temperature": 0.2 } },
      "mode": "all",
      "description": "Creates saved implementation plans under .project"
    },
    "build": {
      "system": "{file:./system/build.md}",
      "request": { "body": { "temperature": 0.3 } },
      "mode": "all",
      "description": "Implements code changes with stepwise verification"
    },
    "plan-inline": {
      "system": "{file:./system/plan-inline.md}",
      "request": { "body": { "temperature": 0.2 } },
      "mode": "all",
      "description": "Creates detailed concrete implementation plans inline without writing files"
    }
  },
  "permissions": [{ "action": "*", "resource": "*", "effect": "allow" }],
  "providers": {
    "anthropic": { "settings": { "apiKey": "{env:ANTHROPIC_API_KEY}" } },
    "openai": {
      "settings": { "apiKey": "{env:OPENAI_API_KEY}" },
      "models": {
        "gpt-6-astra": { "limit": { "context": 1050000, "input": 320000, "output": 128000 } },
        "gpt-6.1-sol": { "limit": { "context": 1050000, "input": 320000, "output": 128000 } }
      }
    },
    "ollama": {
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": { "baseURL": "{env:OLLAMA_HOST}/v1" },
      "models": {
        "qwen2.5-coder:32b": {
          "name": "Qwen 2.5 Coder 32B",
          "limit": { "context": 32768, "output": 8192 }
        },
        "deepseek-coder-v2:latest": {
          "name": "DeepSeek Coder V2",
          "limit": { "context": 131072, "output": 8192 }
        }
      }
    }
  }
}
