# OpenCode Environment Configuration
# Copy to .env for Docker Compose and fill in values.
# The ./opencode wrapper does not source this file: export its inputs securely.

# =============================================================================
# USER/GROUP IDS
# =============================================================================
UID=1000
GID=1000

# =============================================================================
# CLOUD API PROVIDERS (set the ones you need)
# =============================================================================
# Anthropic Claude API
ANTHROPIC_API_KEY=sk-ant-xxxxx

# OpenAI API
OPENAI_API_KEY=sk-xxxxx

# Google Gemini API
GEMINI_API_KEY=

# OpenRouter API
OPENROUTER_API_KEY=

# =============================================================================
# LAN-HOSTED MODELS - OLLAMA
# =============================================================================
# Ollama server URL on your LAN
OLLAMA_HOST=http://ollama.xmist.dev:11434

# =============================================================================
# OPENAI-COMPATIBLE ENDPOINTS (vLLM, LocalAI, LM Studio, etc.)
# =============================================================================
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=

# =============================================================================
# OPENCODE WEB SERVER
# =============================================================================
# Required for every Docker server, including TUI-only/loopback use.
# Native scripts/start.sh service AND session require the same password inputs
# plus OPENCODE_PORT; this file is not sourced by native scripts either.
# The launcher automatically recreates containers when image/config changes;
# active sessions are interrupted, canonical .opencode state is preserved.
# V2 Basic-auth username is fixed to opencode; custom usernames are rejected.
OPENCODE_SERVER_USERNAME=opencode
OPENCODE_PASSWORD=
# OPENCODE_SERVER_PASSWORD is accepted if OPENCODE_PASSWORD is empty or unset.
# OPENCODE_SERVER_PASSWORD=
# Compose-only publication (wrapper uses --web/--wlan flags).
# Compose publishes loopback by default. Set 0.0.0.0 deliberately for LAN.
OPENCODE_WEB_BIND_HOST=127.0.0.1
OPENCODE_WEB_PORT=4096

# Optional advertised host used for OPENCODE_AGENT_WEB_URL inside the container.
# OPENCODE_AGENT_WEB_HOST=your-hostname-or-lan-ip

# =============================================================================
# WORKSPACE CONFIGURATION
# =============================================================================
# Path to your project directory (mounted as /workspace in container)
WORKSPACE_PATH=./workspace

# =============================================================================
# GIT CONFIGURATION (for commits made by opencode)
# =============================================================================
GIT_AUTHOR_NAME=opencode-xmist
GIT_AUTHOR_EMAIL=opencode@xmist.dev

# =============================================================================
# SSH DIRECTORY FOR REMOTE ACCESS
# =============================================================================
# Path to SSH directory containing keys, config, and known_hosts
SSH_DIR_PATH=./ssh

# =============================================================================
# OPTIONAL: CUSTOM GITCONFIG
# =============================================================================
# GITCONFIG_PATH=/home/youruser/.gitconfig
