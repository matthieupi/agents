+import { SessionManager } from "@earendil-works/pi-coding-agent";
+import { getRpcSession } from "./rpc-manager";
+import { resolveSessionPath, readSessionHeader } from "./session-reader";
+import { remoteProjectMode } from "./remote-project-mode";
+
+export async function sessionProjectMode(sessionId: string): Promise<"local" | "remote"> {
+  const wrapper = getRpcSession(sessionId);
+  if (wrapper?.isAlive()) {
+    if (wrapper.inner.sessionId !== sessionId) throw new Error("Session identity changed");
+    return remoteProjectMode(wrapper.inner.sessionManager.getBranch());
+  }
+  const path = await resolveSessionPath(sessionId);
+  if (!path || readSessionHeader(path)?.id !== sessionId) throw new Error("Session not found");
+  return remoteProjectMode(SessionManager.open(path).getBranch());
+}
+
+export async function rejectRemoteProjectRequest(request: Request): Promise<Response | undefined> {
+  const params = new URL(request.url).searchParams;
+  // No session means explicit local picker/control use, not a remote workspace.
+  if (!params.has("sessionId")) return;
+  const ids = params.getAll("sessionId");
+  try {
+    if (ids.length !== 1 || !ids[0]) throw new Error("Missing session context");
+    if (await sessionProjectMode(ids[0]) === "local") return;
+    return Response.json({ error: "Available in Local mode; remote panels are off" }, { status: 409 });
+  } catch {
+    return Response.json({ error: "Cannot verify session project mode; local access blocked" }, { status: 409 });
+  }
+}
