+"use client";
+
+import { createContext, useContext, useEffect, useMemo, useState, type ReactNode } from "react";
+import { projectRequestUrl } from "@/lib/project-request";
+
+const ProjectModeContext = createContext({ sessionId: "" as string | null, local: false });
+
+export function ProjectModeProvider({ sessionId, children }: { sessionId: string | null; children: ReactNode }) {
+  const [resolved, setResolved] = useState<{ id: string; mode: string } | null>(null);
+  useEffect(() => {
+    if (sessionId === null) return;
+    let closed = false;
+    let timer: ReturnType<typeof setTimeout>;
+    const controller = new AbortController();
+    const refresh = async () => {
+      try {
+        const response = await fetch(`/api/sessions/${encodeURIComponent(sessionId)}/state`, {
+          cache: "no-store", signal: controller.signal,
+        });
+        const data = response.ok ? await response.json() : null;
+        if (!closed) setResolved({ id: sessionId, mode: data?.projectMode ?? "unknown" });
+      } catch {
+        if (!closed) setResolved({ id: sessionId, mode: "unknown" });
+      } finally {
+        if (!closed) timer = setTimeout(refresh, 1000);
+      }
+    };
+    void refresh();
+    return () => { closed = true; clearTimeout(timer); controller.abort(); };
+  }, [sessionId]);
+  const local = sessionId === null || (resolved?.id === sessionId && resolved.mode === "local");
+  const value = useMemo(() => ({ sessionId, local }), [sessionId, local]);
+  return <ProjectModeContext.Provider value={value}>{children}</ProjectModeContext.Provider>;
+}
+
+export function useProjectMode() {
+  const context = useContext(ProjectModeContext);
+  return useMemo(() => ({ ...context, url: (path: string) => projectRequestUrl(path, context.sessionId) }), [context]);
+}
+
+export function LocalOnly({ children }: { children: ReactNode }) {
+  const { local } = useProjectMode();
+  return local ? children : <p role="status" style={{ padding: 10, color: "var(--text-muted)" }}>
+    Files, Git, worktrees, @ file index and terminal: available in Local mode. Remote panels are off.
+    Chat and remote tools use the existing /remote extension; select Local explicitly to use these panels.
+  </p>;
+}
