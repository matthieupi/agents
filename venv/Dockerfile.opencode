# VM release build reuses the maintained native V2 latest installer.
ARG OPENCODE_VM_BASE
FROM ${OPENCODE_VM_BASE}
USER root
COPY --chown=0:0 opencode/scripts/entrypoint.sh /opt/opencode/native-contract.sh
COPY --chown=node:node opencode/.opencode/config/opencode.json opencode/.opencode/config/cli.json /opt/opencode/component/.opencode/config/
COPY --chown=node:node opencode/.opencode/config/plugins/first-prompt-title.js opencode/.opencode/config/plugins/background-subagents.js /opt/opencode/component/.opencode/config/plugins/
COPY --chown=node:node opencode/.opencode/config/tui-plugins /opt/opencode/component/.opencode/config/tui-plugins/
COPY --chown=0:0 venv/opencode_health.py /opt/opencode-health.py
RUN install -d -o node -g node /opt/opencode/build-home /opt/opencode/component \
    && test -x /usr/bin/node && test -x /usr/bin/npm
USER node
ENV HOME=/opt/opencode/build-home
# The maintained installer owns version checks, native hooks and runtime layout.
ARG OPENCODE_INSTALL_REFRESH
RUN /bin/bash -c 'set -euo pipefail; : "$OPENCODE_INSTALL_REFRESH"; source /opt/opencode/native-contract.sh; export OPENCODE_USER=node OPENCODE_UID="$(id -u)" OPENCODE_HOME="$HOME" OPENCODE_ROOT=/opt/opencode/component OPENCODE_PREFIX=/opt/opencode/component/.runtime; install_runtime'
USER root
RUN ln -s /opt/opencode/component/.opencode/config /opt/opencode-defaults \
    && chmod -R a+rX,a-w /opt/opencode/component \
    && chmod 0444 /opt/opencode-health.py
ENV PATH=/opt/opencode/component/.runtime/bin:/usr/local/bin:/usr/bin:/bin
USER node
ENTRYPOINT []
CMD ["opencode"]
