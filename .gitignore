# Ignore SSH directories anywhere in the workspace
ssh/
.ssh/
**/ssh/
**/.ssh/

# Ignore environment files anywhere in the workspace
.env
.env.*
**/.env
**/.env.*
!.env.example
!**/.env.example


# Agents local config
.pi
.claude
.agents

# Retain legacy OMP YAML and exceptions in Pi pending offline migration preflight.
# Active OMP runtime now belongs to omp/; never delete legacy private state.
!pi/.pi/
pi/.pi/*
!pi/.pi/agent/
pi/.pi/agent/*
!pi/.pi/agent/config.yml
!pi/.pi/agent/models.yml
!pi/.pi/agent/extensions/
!pi/.pi/agent/extensions/**
!pi/.pi/agent/extension-library/
!pi/.pi/agent/extension-library/**
!pi/.pi/agent/themes/
!pi/.pi/agent/themes/**

# IDE metadata
.idea/

# Python runtime bytecode
__pycache__/
*.py[cod]

# Native Pi generated runtime and install evidence
/pi/.runtime/
/pi/.build.*/
/pi/.lifecycle.lock

# Standalone OMP: runtime state is private except reviewed starter YAML.
.omp
!omp/.omp/
omp/.omp/*
!omp/.omp/.gitignore
!omp/.omp/agent/
omp/.omp/agent/*
!omp/.omp/agent/config.yml
!omp/.omp/agent/models.yml
