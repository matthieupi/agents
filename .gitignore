# Ignore SSH directories anywhere in the workspace
ssh/
.ssh/
**/ssh/
**/.ssh/

# Ignore environment files anywhere in the workspace
.env
.env.*
**/.env
**/.env.*
!.env.example
!**/.env.example


# Agents local config
.pi
.claude
.agents

# Historical private state stays ignored after product retirement.
# Keep Pi extension/theme sources allowed; no legacy OMP YAML exceptions.
!pi/.pi/
pi/.pi/*
!pi/.pi/agent/
pi/.pi/agent/*
!pi/.pi/agent/extensions/
!pi/.pi/agent/extensions/**
!pi/.pi/agent/extension-library/
!pi/.pi/agent/extension-library/**
!pi/.pi/agent/themes/
!pi/.pi/agent/themes/**

# IDE metadata
.idea/

# Native Pi generated runtime and install evidence
/pi/.runtime/
/pi/.build.*/
/pi/.lifecycle.lock

# Retired product data remains private; no tracked starter exceptions.
.omp
/omp/
/t3code/

# Python bytecode: keep after allowlists so caches stay ignored everywhere.
__pycache__/
*.py[cod]
