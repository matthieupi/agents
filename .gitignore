# Ignore SSH directories anywhere in the workspace
ssh/
.ssh/
**/ssh/
**/.ssh/

# Ignore environment files anywhere in the workspace
.env
.env.*
**/.env
**/.env.*
!.env.example
!**/.env.example


# Agents local config
.pi
.claude
.agents

# Keep the OMP coexistence configuration in the Pi harness while ignoring all
# other untracked runtime state under pi/.pi.
!pi/.pi/
pi/.pi/*
!pi/.pi/agent/
pi/.pi/agent/*
!pi/.pi/agent/config.yml
!pi/.pi/agent/models.yml
!pi/.pi/agent/extensions/
!pi/.pi/agent/extensions/**
!pi/.pi/agent/extension-library/
!pi/.pi/agent/extension-library/**
!pi/.pi/agent/themes/
!pi/.pi/agent/themes/**

# IDE metadata
.idea/
