# Compose reads .env; host wrappers read EXPORTED environment only, never source it.
# Use absolute, canonical paths for Compose. The runner selects workspace by argv.
OMP_IMAGE=lab/omp:latest
# Choose IDs matching the intended non-root owner of the bind paths.
# These same IDs are required at image build AND runtime; defaults are not host detection.
# Wrappers: export OMP_UID="$(id -u)" OMP_GID="$(id -g)" before ./omp build and launch.
# In .env, replace the numeric values below; do not put shell command substitutions here.
OMP_UID=1000
OMP_GID=1000
OMP_NETWORK=devai-xmist
OMP_MEMORY=2g
OMP_CPUS=2.0
OMP_PERSONA=build
# Required by Compose: replace with your actual canonical component checkout.
# Safe example only; .env does not execute $(pwd -P). Wrappers derive this themselves.
# OMP_COMPONENT_DIR=/absolute/agents/omp
# Also required by Compose (runner selects workspace by argv or cwd):
# WORKSPACE_PATH=/absolute/project
# OMP_STATE_DIR=/absolute/agents/omp/.omp
# OMP_AGENT_DIR=/absolute/agents/agent
# SSH_DIR_PATH=/absolute/private/ssh
# GITCONFIG_PATH=/absolute/private/gitconfig
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
XAI_API_KEY=
HF_TOKEN=
KIMI_API_KEY=
MINIMAX_API_KEY=
